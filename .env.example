# --- Supabase (wajib untuk notifikasi order) ---
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=eyJ...

# --- Login WhatsApp ---
# LOGIN_METHOD=qr | otp
LOGIN_METHOD=qr
# Wajib jika LOGIN_METHOD=otp (format internasional tanpa +)
PHONE_NUMBER=6281234567890

# --- Telegram (Opsi A: notify-only via Bot API, independen dari WA) ---
# Dapatkan token dari @BotFather -> /newbot
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# ID grup Telegram tujuan (bot harus jadi admin).
# Cara dapat: invite @getmyid_bot ke grup, atau GET /getUpdates. Format: -100xxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
# Opsional: untuk grup forum (topic). Kosongkan jika grup biasa.
# TELEGRAM_TOPIC_ID=
# Opsional: HTML (default) atau kosongkan untuk plain text.
TELEGRAM_PARSE_MODE=HTML
# Opsional: true = kirim silent (tanpa bunyi notif)
# TELEGRAM_DISABLE_NOTIFICATION=false
